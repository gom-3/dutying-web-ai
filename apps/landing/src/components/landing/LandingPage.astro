---
import {ANDROID_PLAY_STORE_URL, IOS_APP_STORE_URL} from '../../config/invite';
import {landingPrimaryCtas, siteConfig} from '../../config/site';

const appStoreLink = IOS_APP_STORE_URL;
const playStoreLink = ANDROID_PLAY_STORE_URL;
const inquiryLink = 'https://ye620.channel.io';

const featureSections = [
    {
        id: 'mobile',
        product: 'App',
        label: '홈',
        title: ['근무관리부터', '개인 일정까지 한번에'],
        description: ['매월 근무 등록하고', '개인 일정을 유형별로 관리해보세요.'],
        desktopImage: '/img/landing_4.webp',
        mobileImage: '/img/landing_mobile_4.webp',
        desktopWidth: 3840,
        desktopHeight: 2160,
        mobileWidth: 780,
        mobileHeight: 1688,
        imageAlt: '듀팅 앱에서 근무와 개인 일정을 함께 관리하는 홈 화면',
        tone: 'light',
        align: 'start',
    },
    {
        product: 'App',
        label: '소셜 (친구 · 모임)',
        title: ['동료의 근무 일정을', '한눈에'],
        description: ['동료와 친구를 맺어', '일정을 편하게 조율해보세요.'],
        desktopImage: '/img/landing_5.webp',
        mobileImage: '/img/landing_mobile_5.webp',
        desktopWidth: 5760,
        desktopHeight: 3240,
        mobileWidth: 780,
        mobileHeight: 1558,
        imageAlt: '친구와 동료의 근무 일정을 비교하는 듀팅 소셜 화면',
        tone: 'dark',
        align: 'end',
    },
    {
        id: 'web',
        product: 'Web',
        label: '근무표 만들기',
        title: ['복잡한 근무표 작성을', '간편하게 자동으로!'],
        description: ['직접 편집한 제약 조건에 맞춰', '근무표를 만들어 드릴게요.'],
        desktopImage: '/img/landing_2.webp',
        mobileImage: '/img/landing_mobile_2.webp',
        desktopWidth: 3840,
        desktopHeight: 2160,
        mobileWidth: 780,
        mobileHeight: 1688,
        imageAlt: '제약 조건을 반영해 간호사 근무표를 작성하는 듀팅 웹 화면',
        tone: 'dark',
        align: 'end',
    },
    {
        product: 'Web',
        label: '근무표 만들기',
        title: ['더 꼼꼼하게,', '하지만 더 편리하게'],
        description: ['근무표 작성을 도와주는', '여러 보조 기능이 준비되어 있어요.'],
        desktopImage: '/img/landing_3.webp',
        mobileImage: '/img/landing_mobile_3.webp',
        desktopWidth: 3840,
        desktopHeight: 2160,
        mobileWidth: 780,
        mobileHeight: 1688,
        imageAlt: '간호사 근무표 편집과 검토를 돕는 듀팅 웹 보조 기능 화면',
        tone: 'dark',
        align: 'start',
    },
];

const formattedFeatureSections = featureSections.map((section) => ({
    ...section,
    titleHtml: section.title.join('<br />'),
    descriptionHtml: section.description.join('<br />'),
}));
---

<main class="landing-page">
    <section class="desktop-only landing-header">
        <div class="landing-header__inner">
            <a class="brand" href={siteConfig.marketingOrigin} aria-label="듀팅 랜딩 홈">
                <img src="/logo-wordmark-purple.png" alt="듀팅" width="119" height="33" />
            </a>

            <nav class="landing-header__nav" aria-label="랜딩 섹션">
                <a href="/features">기능 소개</a>
                <a href="/faq">FAQ</a>
                <a href="/guide">가이드</a>
            </nav>

            <div class="landing-header__actions">
                <a href={appStoreLink} target="_blank" rel="noreferrer" data-ios-download-trigger aria-haspopup="dialog">다운로드</a>
                <a href={inquiryLink} target="_blank" rel="noreferrer">문의하기</a>
                <nav class="auth-text-links" aria-label="계정">
                    <a href={siteConfig.appLinks.login}>로그인</a>
                    <span aria-hidden="true">|</span>
                    <a href={siteConfig.appLinks.signup}>회원가입</a>
                </nav>
            </div>
        </div>
    </section>

    <section class="mobile-only landing-mobile-header">
        <div class="landing-mobile-header__inner">
            <a class="brand brand--mobile" href={siteConfig.marketingOrigin} aria-label="듀팅 랜딩 홈">
                <img src="/logo-wordmark-purple.png" alt="듀팅" width="101" height="28" />
            </a>

            <a
                class="button button--primary button--compact"
                href={appStoreLink}
                target="_blank"
                rel="noreferrer"
                data-ios-download-trigger
                aria-haspopup="dialog"
            >
                다운로드
            </a>
        </div>
    </section>

    <section class="hero">
        <picture class="landing-visual landing-visual--hero">
            <source media="(max-width: 900px)" srcset="/img/landing_mobile_1.webp" width="780" height="1688" />
            <img
                src="/img/landing_1.webp"
                alt="듀팅 앱과 웹에서 간호사 근무 일정을 관리하는 화면"
                width="3840"
                height="2160"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </picture>

        <div class="hero__content hero__content--desktop">
            <div>
                <h1>
                    듀팅,
                    <br />
                    이제 더 간편하게!
                </h1>

                <div class="hero-copy-group">
                    <div class="copy-line">
                        <span class="pill pill--highlight">App</span>
                        <p>일정 관리의 모든 여정이 더 편리해져요.</p>
                    </div>
                    <div class="copy-line">
                        <span class="pill pill--highlight">Web</span>
                        <p>근무표를 더 쉽고 빠르게 작성하도록 도와드려요.</p>
                    </div>
                </div>

                <div class="cta-block">
                    <div class="cta-block__heading">
                        <span class="pill pill--highlight">App</span>
                        <p>근무 일정 관리 (일반 간호사 용)</p>
                    </div>
                    <div class="cta-row">
                        <a
                            class="button button--store"
                            href={appStoreLink}
                            target="_blank"
                            rel="noreferrer"
                            data-ios-download-trigger
                            aria-haspopup="dialog"
                        >
                            <img class="store-logo" src="/img/apple.png" alt="" aria-hidden="true" />
                            App Store
                        </a>
                        <a class="button button--store" href={playStoreLink} target="_blank" rel="noreferrer">
                            <img class="store-logo" src="/img/play.png" alt="" aria-hidden="true" />
                            Google Play
                        </a>
                    </div>
                </div>

                <div class="cta-block">
                    <div class="cta-block__heading">
                        <span class="pill pill--highlight">Web</span>
                        <p>근무표 작성 (수간호사 용)</p>
                    </div>
                    <div class="cta-row">
                        {landingPrimaryCtas.map((cta) => (
                            <a class="button button--store" href={cta.href}>{cta.label}</a>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        <div class="hero__content hero__content--mobile">
            <h1>
                근무표,
                <br />
                이제 더 간편하게!
            </h1>

            <div class="cta-block cta-block--mobile">
                <div class="cta-block__heading">
                    <span class="pill pill--highlight">App</span>
                    <p>근무 일정 관리 (일반 간호사 용)</p>
                </div>
                <div class="cta-row cta-row--mobile">
                    <a
                        class="button button--store button--mobile"
                        href={appStoreLink}
                        target="_blank"
                        rel="noreferrer"
                        data-ios-download-trigger
                        aria-haspopup="dialog"
                    >
                        <img class="store-logo" src="/img/apple.png" alt="" aria-hidden="true" />
                        App Store
                    </a>
                    <a class="button button--store button--mobile" href={playStoreLink} target="_blank" rel="noreferrer">
                        <img class="store-logo" src="/img/play.png" alt="" aria-hidden="true" />
                        Google Play
                    </a>
                </div>
            </div>
        </div>
    </section>

    {formattedFeatureSections.map((section) => (
        <section
            id={section.id}
            class:list={['feature-section', section.align === 'end' ? 'feature-section--end' : 'feature-section--start']}
        >
            <picture class="landing-visual">
                <source
                    media="(max-width: 900px)"
                    srcset={section.mobileImage}
                    width={section.mobileWidth}
                    height={section.mobileHeight}
                />
                <img
                    src={section.desktopImage}
                    alt={section.imageAlt}
                    width={section.desktopWidth}
                    height={section.desktopHeight}
                    loading="lazy"
                    decoding="async"
                />
            </picture>

            <div class="feature-section__inner">
                <article class:list={['feature-copy', section.tone === 'light' ? 'feature-copy--light' : 'feature-copy--dark']}>
                    <div class="feature-copy__label">
                        <span class:list={['pill', section.tone === 'light' ? 'pill--light' : 'pill--highlight']}>{section.product}</span>
                        <p>{section.label}</p>
                    </div>
                    <h2 set:html={section.titleHtml} />
                    <p set:html={section.descriptionHtml} />
                </article>
            </div>
        </section>
    ))}

    <footer class="desktop-only landing-footer">
        <div class="landing-footer__inner">
            <section>
                <h2>듀팅 다운로드</h2>

                <div class="footer-row">
                    <span>모바일 앱</span>
                    <div class="cta-row">
                        <a
                            class="button button--footer"
                            href={appStoreLink}
                            target="_blank"
                            rel="noreferrer"
                            data-ios-download-trigger
                            aria-haspopup="dialog"
                        >
                            <img class="store-logo" src="/img/apple.png" alt="" aria-hidden="true" />
                            App Store
                        </a>
                        <a class="button button--footer" href={playStoreLink} target="_blank" rel="noreferrer">
                            <img class="store-logo" src="/img/play.png" alt="" aria-hidden="true" />
                            Google Play
                        </a>
                    </div>
                </div>

                <div class="footer-row">
                    <span>웹</span>
                    <div class="cta-row">
                        <a class="button button--footer" href={siteConfig.appLinks.makeEntry}>근무표 작성 체험하기</a>
                        <a class="button button--footer" href={siteConfig.appLinks.make}>근무표 만들기</a>
                    </div>
                </div>
            </section>

            <section class="landing-footer__links">
                <a href={inquiryLink} target="_blank" rel="noreferrer">제휴 문의</a>
            </section>
        </div>

        <p class="landing-footer__google-note">
            Google 계정 로그인 시 제공받는 이메일 주소, 이름, 계정 식별자 및 사용자가 동의한 경우 전화번호는 회원가입, 로그인, 계정 식별 목적으로만 사용하며 광고 목적으로 사용하지 않습니다.
        </p>

        <div class="landing-footer__bottom">
            <a href={siteConfig.legal.terms} target="_blank" rel="noreferrer">이용 약관</a>
            <a href={siteConfig.legal.privacyPolicy} target="_blank" rel="noreferrer">개인 정보 처리 방침</a>
            <a href={siteConfig.legal.accountDeletion}>계정삭제 안내</a>
            <a href="/faq">FAQ</a>
            <a href="/guide">가이드</a>
        </div>
    </footer>

    <footer class="mobile-only landing-footer landing-footer--mobile">
        <div class="landing-footer__inner landing-footer__inner--mobile">
            <section>
                <h2>듀팅 다운로드</h2>

                <div class="footer-column">
                    <span>모바일 앱</span>
                    <div class="cta-row cta-row--mobile">
                        <a
                            class="button button--footer button--mobile"
                            href={appStoreLink}
                            target="_blank"
                            rel="noreferrer"
                            data-ios-download-trigger
                            aria-haspopup="dialog"
                        >
                            <img class="store-logo" src="/img/apple.png" alt="" aria-hidden="true" />
                            App Store
                        </a>
                        <a class="button button--footer button--mobile" href={playStoreLink} target="_blank" rel="noreferrer">
                            <img class="store-logo" src="/img/play.png" alt="" aria-hidden="true" />
                            Google Play
                        </a>
                    </div>
                </div>

                <div class="footer-column">
                    <span>웹</span>
                    <div class="cta-row cta-row--mobile">
                        <a class="button button--footer button--mobile" href={siteConfig.appLinks.makeEntry}>근무표 작성 체험하기</a>
                        <a class="button button--footer button--mobile" href={siteConfig.appLinks.make}>근무표 만들기</a>
                    </div>
                </div>

                <a class="footer-contact" href={inquiryLink} target="_blank" rel="noreferrer">제휴 문의</a>
            </section>
        </div>

        <p class="landing-footer__google-note landing-footer__google-note--mobile">
            Google 계정 로그인 시 제공받는 이메일 주소, 이름, 계정 식별자 및 사용자가 동의한 경우 전화번호는 회원가입, 로그인, 계정 식별 목적으로만 사용하며 광고 목적으로 사용하지 않습니다.
        </p>

        <div class="landing-footer__bottom landing-footer__bottom--mobile">
            <a href={siteConfig.legal.terms} target="_blank" rel="noreferrer">이용 약관</a>
            <a href={siteConfig.legal.privacyPolicy} target="_blank" rel="noreferrer">개인 정보 처리 방침</a>
            <a href={siteConfig.legal.accountDeletion}>계정삭제 안내</a>
            <a href="/faq">FAQ</a>
            <a href="/guide">가이드</a>
        </div>
    </footer>

    <div
        class="download-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="ios-download-modal-title"
        aria-describedby="ios-download-modal-description"
        data-ios-download-modal
        hidden
    >
        <div class="download-modal__panel" data-ios-download-panel tabindex="-1">
            <button class="download-modal__close" type="button" data-ios-download-close aria-label="닫기">
                <span aria-hidden="true">×</span>
            </button>

            <p class="download-modal__eyebrow">준비중</p>
            <h2 id="ios-download-modal-title">iOS 앱은 준비중이에요</h2>
            <p id="ios-download-modal-description">9월 말 오픈 예정입니다.</p>

            <button class="button button--primary download-modal__confirm" type="button" data-ios-download-close>
                확인
            </button>
        </div>
    </div>
</main>

<script>
    const iosDownloadModal = document.querySelector('[data-ios-download-modal]');
    const iosDownloadTriggers = document.querySelectorAll('[data-ios-download-trigger]');
    const iosDownloadCloseButtons = document.querySelectorAll('[data-ios-download-close]');
    let lastFocusedElement: Element | null = null;

    const getModalFocusableElements = () => {
        if (!(iosDownloadModal instanceof HTMLElement)) return [];

        return Array.from(
            iosDownloadModal.querySelectorAll<HTMLElement>(
                'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )
        );
    };

    const openIosDownloadModal = (event: Event) => {
        event.preventDefault();

        if (!(iosDownloadModal instanceof HTMLElement)) return;

        lastFocusedElement = document.activeElement;
        iosDownloadModal.hidden = false;
        document.documentElement.classList.add('ios-download-modal-open');
        document.body.classList.add('ios-download-modal-open');

        const panel = iosDownloadModal.querySelector('[data-ios-download-panel]');
        if (panel instanceof HTMLElement) {
            panel.focus();
        }
    };

    const closeIosDownloadModal = () => {
        if (!(iosDownloadModal instanceof HTMLElement) || iosDownloadModal.hidden) return;

        iosDownloadModal.hidden = true;
        document.documentElement.classList.remove('ios-download-modal-open');
        document.body.classList.remove('ios-download-modal-open');

        if (lastFocusedElement instanceof HTMLElement) {
            lastFocusedElement.focus();
        }
    };

    iosDownloadTriggers.forEach((trigger) => {
        trigger.addEventListener('click', openIosDownloadModal);
    });

    iosDownloadCloseButtons.forEach((button) => {
        button.addEventListener('click', closeIosDownloadModal);
    });

    if (iosDownloadModal instanceof HTMLElement) {
        iosDownloadModal.addEventListener('click', (event) => {
            if (event.target === iosDownloadModal) {
                closeIosDownloadModal();
            }
        });
    }

    document.addEventListener('keydown', (event) => {
        if (!(iosDownloadModal instanceof HTMLElement) || iosDownloadModal.hidden) return;

        if (event.key === 'Escape') {
            closeIosDownloadModal();
            return;
        }

        if (event.key !== 'Tab') return;

        const focusableElements = getModalFocusableElements();
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (!firstElement || !lastElement) return;

        if (event.shiftKey && document.activeElement === firstElement) {
            event.preventDefault();
            lastElement.focus();
        } else if (!event.shiftKey && document.activeElement === lastElement) {
            event.preventDefault();
            firstElement.focus();
        }
    });
</script>

<style>
    .landing-page {
        color: #150b3c;
        background: #fff;
    }

    .landing-page a {
        color: inherit;
        text-decoration: none;
    }

    .desktop-only {
        display: block;
    }

    .mobile-only {
        display: none;
    }

    .landing-header,
    .landing-mobile-header {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid rgba(21, 11, 60, 0.08);
        background: #fff;
    }

    .landing-header__inner,
    .landing-mobile-header__inner,
    .hero__content--desktop,
    .feature-section__inner,
    .landing-footer__inner,
    .landing-footer__bottom {
        width: min(1200px, calc(100% - 48px));
        margin: 0 auto;
    }

    .landing-header__inner {
        display: flex;
        align-items: center;
        height: 72px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
    }

    .brand img,
    .brand--mobile img {
        display: block;
        width: 119px;
        height: auto;
    }

    .landing-header__nav {
        display: flex;
        gap: 45px;
        margin-left: auto;
        padding-right: 60px;
        border-right: 1px solid #e5e3eb;
    }

    .landing-header__nav a,
    .landing-header__actions a {
        font-size: 1.125rem;
        font-weight: 500;
    }

    .landing-header__nav a {
        color: #71698d;
        text-decoration: underline;
        text-underline-offset: 5px;
    }

    .landing-header__actions {
        display: flex;
        align-items: center;
        gap: 32px;
        margin-left: 48px;
    }

    .auth-text-links {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #150b3c;
        font-size: 1.125rem;
        font-weight: 700;
        line-height: 1;
    }

    .landing-header__actions .auth-text-links a {
        font-weight: 700;
    }

    .auth-text-links span {
        color: #a29bb7;
    }

    .landing-header__actions > a:not(.button),
    .landing-footer__links a,
    .landing-footer__bottom a,
    .footer-contact {
        color: #595961;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        border: 0;
        border-radius: 15px;
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.15;
        text-align: center;
        overflow-wrap: anywhere;
        cursor: pointer;
        transition:
            transform 160ms ease,
            box-shadow 160ms ease,
            background-color 160ms ease;
    }

    .button:hover {
        transform: translateY(-1px);
    }

    .landing-page .button--primary {
        background: #663dfa;
        color: #fff;
    }

    .button--compact {
        min-height: 40px;
        padding: 0 16px;
        border-radius: 30px;
        font-size: 1.125rem;
    }

    .button--store,
    .button--footer {
        gap: 8px;
        min-width: min(320px, 100%);
        min-height: 60px;
        padding: 12px 24px;
        background: #fff;
        color: #150b3c;
        box-shadow: 0 20px 50px rgba(18, 20, 31, 0.12);
    }

    .button--footer {
        min-width: min(210px, 100%);
        min-height: 38px;
        border-radius: 8px;
        background: #f5f5f7;
        box-shadow: none;
        font-size: 1rem;
    }

    .store-logo {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        object-fit: contain;
    }

    .button--footer .store-logo {
        width: 18px;
        height: 18px;
    }

    .hero,
    .feature-section {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
    }

    .landing-visual {
        position: absolute;
        inset: 0;
        z-index: 0;
        display: block;
        width: 100%;
        height: 100%;
    }

    .landing-visual img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .hero__content,
    .feature-section__inner {
        position: relative;
        z-index: 1;
    }

    .hero__content--mobile {
        display: none;
    }

    .hero__content--desktop {
        display: flex;
        align-items: center;
        min-height: calc(100svh - 72px);
        padding: 88px 0 80px;
    }

    .hero__content--desktop > div {
        max-width: 640px;
    }

    .hero h1,
    .feature-copy h2 {
        margin: 0;
        letter-spacing: -0.04em;
    }

    .hero h1 {
