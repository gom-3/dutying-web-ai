---
import '../styles/global.css';
import {siteConfig} from '../config/site';

interface Props {
    title?: string;
    description?: string;
    robots?: string;
    canonicalPath?: string;
    structuredData?: Record<string, unknown>;
    preloadHero?: boolean;
}

const {
    title = '듀팅 | 간호사 근무표를 위한 운영 플랫폼',
    description = '간호사 근무표 작성과 일정 관리를 더 편리하게. 듀팅과 함께 효율적인 근무 관리를 시작해요.',
    robots,
    canonicalPath,
    structuredData,
    preloadHero = false,
} = Astro.props;

const requestedPath = canonicalPath ?? Astro.url.pathname;
const extensionlessPath = requestedPath === '/index.html' ? '/' : requestedPath.replace(/\.html$/, '');
const normalizedCanonicalPath = extensionlessPath === '/' ? '/' : extensionlessPath.replace(/\/+$/, '');
const canonicalUrl = new URL(normalizedCanonicalPath, `${siteConfig.marketingOrigin}/`).toString();
const ogImageUrl = new URL('/og-image-preview222.png', `${siteConfig.marketingOrigin}/`).toString();

---

<!doctype html>
<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="icon" type="image/png" href="/favicon.png" />
        {preloadHero ? <link rel="preload" as="image" href="/img/landing_mobile_1.webp" media="(max-width: 900px)" fetchpriority="high" /> : null}
        {preloadHero ? <link rel="preload" as="image" href="/img/landing_1.webp" media="(min-width: 901px)" fetchpriority="high" /> : null}
        <meta name="description" content={description} />
        <meta name="title" content={title} />
        {robots ? <meta name="robots" content={robots} /> : null}
        <!-- 네이버 서치어드바이저 소유확인. www.dutying.ai 등록 시 발급받은 코드 (2026-08-23). -->
        <meta name="naver-site-verification" content="b36072ee7cbeca0c21c8b390bd7ebf77b0e64990" />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="듀팅 공유 미리보기 이미지" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        {structuredData ? <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline /> : null}
    </head>
    <body>
        <slot />
    </body>
</html>
