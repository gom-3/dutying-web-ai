---
import {ANDROID_PLAY_STORE_URL, buildFriendInviteAppUrl, IOS_APP_STORE_URL} from '../../../config/invite';
import {siteConfig} from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const fallbackAppUrl = buildFriendInviteAppUrl(siteConfig.appOrigin);
---

<BaseLayout
    title="듀팅 초대 열기"
    description="듀팅 앱에서 친구 초대를 이어서 확인하세요."
    robots="noindex, nofollow"
>
    <main class="invite-page">
        <section class="invite-panel" aria-labelledby="invite-title">
            <a class="brand" href={siteConfig.marketingOrigin} aria-label="듀팅 홈">
                <img src="/logo-wordmark-purple.png" alt="dutying" width="118" height="33" />
            </a>

            <div class="invite-copy">
                <p class="eyebrow">친구 초대</p>
                <h1 id="invite-title">듀팅 앱에서 초대를 열어주세요</h1>
                <p class="description">
                    <span>앱이 바로 열리지 않나요?</span>
                    <span>아래 버튼으로 초대를 이어서 확인하세요.</span>
                </p>
            </div>

            <div class="invite-code" data-invite-code-wrap hidden aria-live="polite">
                <span>친구 코드</span>
                <strong data-invite-code></strong>
            </div>

            <div class="action-stack">
                <a
                    class="button button--primary"
                    href={fallbackAppUrl}
                    data-app-open-link
                    data-app-origin={siteConfig.appOrigin}
                >
                    듀팅 앱에서 초대 열기
                </a>

                <div class="store-guide" aria-label="앱 설치 안내">
                    <p>
                        <strong class="store-title">앱이 아직 없다면?</strong>
                        <span>스토어에서 먼저 설치해주세요.</span>
                    </p>
                    <div class="store-buttons">
                        <a class="button button--secondary" href={IOS_APP_STORE_URL} target="_blank" rel="noreferrer">
                            <img src="/img/apple.png" alt="" aria-hidden="true" />
                            App Store에서 받기
                        </a>
                        <a class="button button--secondary" href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noreferrer">
                            <img src="/img/play.png" alt="" aria-hidden="true" />
                            Google Play에서 받기
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script>
        const appendCurrentSearch = (baseUrl: string) => {
            const search = window.location.search || '';
            const hash = window.location.hash || '';
            return `${baseUrl}${search}${hash}`;
        };

        const openButton = document.querySelector('[data-app-open-link]');
        const inviteCodeWrap = document.querySelector('[data-invite-code-wrap]');
        const inviteCodeText = document.querySelector('[data-invite-code]');
        const inviteCode = new URLSearchParams(window.location.search).get('code')?.trim();

        if (openButton instanceof HTMLAnchorElement) {
            const appOrigin = openButton.dataset.appOrigin?.replace(/\/+$/, '') || 'https://app.dutying.ai';
            const appUrl = appendCurrentSearch(`${appOrigin}/app/friends/invite`);

            openButton.href = appUrl;
        }

        if (inviteCode && inviteCodeWrap instanceof HTMLElement && inviteCodeText instanceof HTMLElement) {
            inviteCodeText.textContent = inviteCode;
            inviteCodeWrap.hidden = false;
        }
    </script>
</BaseLayout>

<style>
    .invite-page {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 32px 20px 28px;
        background: #f7f8fa;
        color: #191f28;
    }

    .invite-panel {
        width: min(100%, 400px);
        padding: 36px 24px 24px;
        border-radius: 8px;
        background: #fff;
        text-align: center;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 32px;
    }

    .brand img {
        display: block;
        width: 118px;
        height: auto;
    }

    .invite-copy {
        display: grid;
        gap: 12px;
        word-break: keep-all;
        overflow-wrap: normal;
    }

    .eyebrow {
        margin: 0;
        color: #6c5ce7;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.25;
    }

    h1 {
        margin: 0;
        color: #191f28;
        font-size: 26px;
        line-height: 1.32;
        letter-spacing: 0;
    }

    .description,
    .store-guide p {
        margin: 0;
        color: #6b7684;
        font-size: clamp(14px, 3.6vw, 15px);
        line-height: 1.6;
    }

    .description span,
    .store-guide span {
        display: block;
        white-space: nowrap;
    }

    .action-stack {
        display: grid;
        gap: 12px;
        margin-top: 26px;
    }

    .invite-code {
        display: flex;
        min-height: 68px;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        width: 100%;
        margin-top: 20px;
        padding: 16px 18px;
        border-radius: 8px;
        background: #f3f0ff;
        color: #6c5ce7;
        text-align: left;
        word-break: keep-all;
    }

    .invite-code[hidden] {
        display: none;
    }

    .invite-code span {
        color: #6c5ce7;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.3;
        white-space: nowrap;
    }

    .invite-code strong {
        color: #191f28;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
        font-size: clamp(24px, 7.2vw, 30px);
        font-weight: 900;
        letter-spacing: 0.06em;
        line-height: 1.1;
        white-space: nowrap;
    }

    .button {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 8px;
        padding: 14px 18px;
        font-size: clamp(14px, 4vw, 16px);
        font-weight: 700;
        line-height: 1.35;
        text-decoration: none;
        white-space: nowrap;
    }

    .button--primary {
        background: #6c5ce7;
        color: #fff;
    }

    .button--secondary {
        width: 100%;
        min-height: 56px;
        background: #191f28;
        color: #fff;
    }

    .button--secondary img {
        width: 18px;
        height: 18px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .store-guide {
        padding: 18px 16px 16px;
        border-radius: 8px;
        background: #f8f6ff;
        word-break: keep-all;
        overflow-wrap: normal;
    }

    .store-buttons {
        display: grid;
        gap: 10px;
        margin-top: 12px;
    }

    .store-guide p {
        color: #6b7684;
    }

    .store-title {
        display: block;
        margin: 0 auto 5px;
        color: #6c5ce7;
        font-size: clamp(18px, 4.8vw, 20px);
        font-weight: 900;
        letter-spacing: 0;
        line-height: 1.25;
    }

    @media (max-width: 420px) {
        .invite-page {
            padding: 18px;
            place-items: stretch;
        }

        .invite-panel {
            align-self: center;
            padding: 32px 20px 22px;
        }

        h1 {
            font-size: 23px;
        }

        .invite-code {
            padding: 16px;
            gap: 10px;
        }
    }

    @media (max-width: 340px) {
        .invite-panel {
            padding-inline: 16px;
        }

        .invite-code {
            display: grid;
            justify-items: center;
            text-align: center;
        }

        .button {
            padding-inline: 12px;
            font-size: 13px;
        }
    }
</style>
