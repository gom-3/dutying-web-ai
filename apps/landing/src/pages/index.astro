---
import BaseLayout from '../layouts/BaseLayout.astro';
import {siteConfig} from '../config/site';

const ctaGroups = [
    {
        eyebrow: 'dutying.net',
        title: '브랜드와 제품 소개는 랜딩에서 맡습니다.',
        description: 'Astro 기반 정적 앱으로 제품 소개, 도입 맥락, 신뢰 요소, 주요 CTA를 담당합니다.',
        actions: [
            {label: '앱 시작하기', href: siteConfig.appLinks.login, variant: 'primary'},
            {label: '근무표 만들기 바로 가기', href: siteConfig.appLinks.make, variant: 'secondary'},
        ],
    },
    {
        eyebrow: 'app.dutying.net',
        title: '실제 제품 사용 흐름은 앱에서 이어집니다.',
        description: '로그인, 온보딩, 근무표 생성/관리, 멤버 관리 같은 인증 이후 경험은 제품 앱이 전담합니다.',
        actions: [
            {label: '앱 홈 열기', href: siteConfig.appLinks.home, variant: 'secondary'},
            {label: '회원가입 진입', href: siteConfig.appLinks.register, variant: 'secondary'},
        ],
    },
];

const boundaryItems = [
    {
        title: 'Landing responsibility',
        body: '마케팅 카피, 제품 가치 제안, SEO/OG, 브랜드 스토리, 앱 진입 CTA를 담당합니다.',
    },
    {
        title: 'App responsibility',
        body: '로그인 이후 라우팅, 인증 세션, 스케줄 생성/관리, 실제 제품 기능을 담당합니다.',
    },
    {
        title: 'Next follow-up',
        body: '기존 app 루트에 남아 있는 레거시 랜딩/도메인 하드코딩은 후속 티켓에서 정리합니다.',
    },
];
---

<BaseLayout>
    <main class="shell">
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">Astro landing bootstrap</p>
                <h1>랜딩은 `dutying.net`, 제품 앱은 `app.dutying.net`으로 나눕니다.</h1>
                <p class="lede">
                    이번 단계는 랜딩을 별도 Astro 앱으로 분리하고, 앱 진입 CTA와 후속 점검 범위를 명확히 드러내는
                    기반 작업입니다.
                </p>
                <div class="hero-actions">
                    <a class="button primary" href={siteConfig.appLinks.login}>앱으로 이동</a>
                    <a class="button ghost" href="#boundary">책임 경계 보기</a>
                </div>
            </div>

            <aside class="hero-panel">
                <p class="panel-label">Current split</p>
                <dl>
                    <div>
                        <dt>Landing origin</dt>
                        <dd>{siteConfig.marketingOrigin}</dd>
                    </div>
                    <div>
                        <dt>App origin</dt>
                        <dd>{siteConfig.appOrigin}</dd>
                    </div>
                    <div>
                        <dt>Primary CTA</dt>
                        <dd>{siteConfig.appLinks.login}</dd>
                    </div>
                </dl>
            </aside>
        </section>

        <section class="grid">
            {ctaGroups.map((group) => (
                <article class="card">
                    <p class="eyebrow">{group.eyebrow}</p>
                    <h2>{group.title}</h2>
                    <p>{group.description}</p>
                    <div class="card-actions">
                        {group.actions.map((action) => (
                            <a class:list={['button', action.variant === 'primary' ? 'primary' : 'secondary']} href={action.href}>
                                {action.label}
                            </a>
                        ))}
                    </div>
                </article>
            ))}
        </section>

        <section id="boundary" class="boundary">
            <div class="section-heading">
                <p class="eyebrow">Boundary</p>
                <h2>이번 작업에서 고정한 경계</h2>
            </div>
            <div class="boundary-list">
                {boundaryItems.map((item) => (
                    <article class="boundary-item">
                        <h3>{item.title}</h3>
                        <p>{item.body}</p>
                    </article>
                ))}
            </div>
        </section>
    </main>
</BaseLayout>
